# Copy to .env.local for local development. Never commit a filled-in copy.

# ---------------------------------------------------------------------------
# Inquiry API + /admin (server-side, read by the functions in /api).
# What each value is and where to get it: docs/aws-setup.md.
# Run the API locally with `vercel dev` (npm run dev serves only the site).
APP_AWS_REGION=us-east-2
APP_AWS_ACCESS_KEY_ID=
APP_AWS_SECRET_ACCESS_KEY=
INQUIRIES_TABLE=inquiries
UPLOADS_BUCKET=
SES_FROM_EMAIL=inquiries@murilloconsulting.co
NOTIFY_EMAIL=
# Cloudflare's always-pass test keys; real keys only in Vercel.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
# openssl rand -base64 48
SESSION_SECRET=
SITE_URL=http://localhost:3000
